{
  "name": "gameplot",
  "version": "2.0.0-dev",
  "description": "Personal video-game dashboard: scrapes playtime from Steam, PSN, Xbox and GOG, merges it with hand-written ratings and tags, and renders an interactive D3 page.",
  "type": "module",
  "private": true,
  "bin": {
    "gameplot": "bin/gameplot.js"
  },
  "scripts": {
    "setup:dev": "npm ci --include=dev && playwright install chromium",
    "test": "node --test tests/*.test.js",
    "lint": "biome check",
    "format": "biome check --write",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "fs-extra": "^11.4.1",
    "open": "^11.0.4",
    "psn-api": "^2.18.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "d3": "^7.8.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
