# Copy to .env and fill in. .env is gitignored.
#
# PSN: an NPSSO token. Tokens expire after roughly two months; when one is
# missing or rejected, `gameplot scrape psn` walks you through getting a
# fresh one in the browser.
PSN_NPSSO=
#
# Several PSN accounts? Give each a label and scrape them one at a time with
# `gameplot scrape psn --account <label>`. The variable suffix is the label
# in upper case.
# PSN_NPSSO_UK=
# PSN_NPSSO_US=
